{
  "name": "@inno/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "create-super-admin": "tsx src/scripts/createSuperAdmin.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "archiver": "^8.0.0",
    "argon2": "^0.44.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.2",
    "image-size": "^2.0.4",
    "jose": "^6.1.2",
    "jpeg-js": "^0.4.4",
    "nodemailer": "^10.1.7",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.3",
    "pngjs": "^7.0.0",
    "zod": "^4.1.12"
  },
  "overrides": {
    "readdir-glob@3": {
      "minimatch": "^11.0.1"
    },
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.15.5",
    "@types/pngjs": "^6.0.5",
    "embedded-postgres": "^16.14.0-beta.17",
    "fflate": "^0.8.2",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  }
}
