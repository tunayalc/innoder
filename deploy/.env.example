COMPOSE_PROJECT_NAME=inno-production
INNO_ENV_FILE=.env.example
POSTGRES_DB=inno
POSTGRES_USER=inno
POSTGRES_PASSWORD=CHANGE_WITH_LONG_RANDOM_PASSWORD
DATABASE_URL=postgres://inno:CHANGE_WITH_LONG_RANDOM_PASSWORD@postgres:5432/inno
DATABASE_SSL=false
JWT_SECRET=CHANGE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ESC_BLOOD_GROUP_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
FILE_STORAGE_PATH=/data/documents
MAX_FILE_BYTES=20971520
HOST=0.0.0.0
PORT=3000
NODE_ENV=production
API_DOMAIN=api.innoder.org
ADMIN_DOMAIN=admin.innoder.org
PUBLIC_API_URL=https://api.innoder.org
ALLOWED_ORIGINS=https://admin.innoder.org
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_USER=noreply@example.org
SMTP_PASSWORD=
SMTP_PASSWORD_BASE64=CHANGE_WITH_BASE64_ENCODED_SMTP_PASSWORD
SMTP_FROM=Inno Association <noreply@example.org>
PASSWORD_RESET_URL=https://api.innoder.org/reset-password
TLS_EMAIL=admin@example.org
BACKUP_ENCRYPTION_PASSWORD=CHANGE_WITH_SEPARATELY_STORED_RANDOM_PASSWORD
RCLONE_CONFIG_FILE=/opt/inno/rclone.conf
RCLONE_REMOTE=offsite:inno-production-backups
ALERT_WEBHOOK_URL=https://alerts.example.org/inno
DISK_ALERT_PERCENT=80
SUPER_ADMIN_EMAIL=admin@example.org
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=CHANGE_WITH_STRONG_TEMPORARY_PASSWORD
